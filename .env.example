# URL do Web App do Apps Script (termina em /exec).
# Em produção essa URL vem da variável API_URL do GitHub Actions (ver docs/CONFIGURAR.md).
# Sem ela, o site roda em modo demonstração: nada é gravado e o Pix é de teste.
VITE_API_URL=

# Opcional: chave PÚBLICA do Cloudflare Turnstile (anti-robô). Vazia = verificação desligada.
# A chave SECRETA nunca vai aqui: fica nas Propriedades do script no Apps Script (TURNSTILE_SECRET).
VITE_TURNSTILE_SITE_KEY=
